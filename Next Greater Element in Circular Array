class Solution {
  public:
    vector<int> nextGreater(vector<int> &arr) {
        // code here
        int n=arr.size();
        vector<int> result(n);
        stack<int> mi;
        for(int i=2*n-1;i>=0;i--){
            while(!mi.empty() && mi.top()<=arr[i%n]){
                        mi.pop();
            }if(i<n){
                if(mi.empty()){
                    result[i]=-1;
                }else{
                    result[i]=mi.top();
                }
            }
            mi.push(arr[i%n]);
        }return result;
        
    }
};
