class Solution {
public:
    string longestCommonPrefix(vector<string>& strs) {
        string ans="";
        string tocheck=strs[0];
        for(int i=0;i<tocheck.size();i++){
            char k=tocheck[i];
            for(int j=1;j<strs.size();j++){
                if(i==strs[j].size() || k!=strs[j][i]){
                    return ans;
                }
            }
            ans+=k;
        }return ans;
    }
};
