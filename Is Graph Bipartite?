class Solution {
public:
    bool isBipartite(vector<vector<int>>& graph) {
        queue<int> q;
        vector<int> visited(graph.size(), 0);
        vector<int> dist(graph.size(), INT_MAX);
        vector<int> parent(graph.size(), -1);

        for (int k = 0; k < graph.size(); k++) {
            if (!visited[k]) {
                q.push(k);
                visited[k] = 1;
                dist[k] = 0;
                while (!q.empty()) {
                    int u = q.front();
                    q.pop();
                    for (auto v : graph[u]) {
                        if (visited[v] == 0) {
                            dist[v] = dist[u] + 1;
                            parent[v] = u;
                            q.push(v);
                            visited[v] = 1;
                        } else {
                            if (parent[u] != v) {
                                int len = dist[u] + dist[v] + 1;
                                if (len % 2 != 0)
                                    return false;
                            }
                        }
                    }
                }
            }
        }
        return true;
    }
};
