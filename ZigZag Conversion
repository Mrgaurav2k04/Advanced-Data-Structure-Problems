class Solution {
public:
    string convert(string s, int numRows) {
        string ans="";
        if(s.size()==1 || numRows==1 || s.size()==numRows) return s;
        int gap=2*numRows-2;
        for(int i=0;i<numRows;i++){
            for(int j=0;i+j<s.size();j+=gap){
                ans+=s[i+j];
                int diag=j+gap-i;
                if(i!=0 && i!=numRows-1 && diag<s.size()){
                    ans+=s[diag];
                }

            }
        }return ans;
    }
};
